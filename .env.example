DATABASE_URL=postgres://archaeologist:archaeologist_dev@localhost:5432/archaeologist
RUST_LOG=info,sqlx=warn

# ── LLM Provider Selection ────────────────────────────────────────────────────
# Which backend to use for AI-powered answers in `ask` command.
# Supported values: watsonx (default) | openai | anthropic | ollama | mock
LLM_PROVIDER=watsonx
LLM_MODEL=ibm/granite-4-h-small
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── IBM watsonx (PRIMARY ★) ───────────────────────────────────────────────────
# Get credentials at: https://cloud.ibm.com/iam/apikeys
# Get project ID at:  https://dataplatform.cloud.ibm.com/
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL=ibm/granite-4-h-small
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com

# ── OpenAI (secondary) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic / Claude (secondary) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Ollama (local fallback) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HTTP_ADDR=0.0.0.0:8080
